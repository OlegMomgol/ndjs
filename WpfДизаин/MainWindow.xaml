<Window x:Class="WpfДизаин.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Player" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F4F7F6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="70" Background="White" CornerRadius="12,12,0,0" Margin="15,0,15,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="40" Height="40" Fill="Pink" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Наедине" FontWeight="Bold" FontSize="20" Foreground="Black"/>
                        <TextBlock Text="Nyusha" FontSize="13" Foreground="Black"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="⏮" Width="30" Height="30" Margin="5" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="▶" Width="35" Height="35" Margin="5" Background="Pink" Foreground="Black" FontWeight="Bold"/>
                    <Button Content="⏭" Width="30" Height="30" Margin="5" Background="Transparent" BorderBrush="Transparent"/>
                </StackPanel>

                <Slider Grid.Column="2" Width="120" VerticalAlignment="Center" Value="50"/>
            </Grid>
        </Border>

        <Border Grid.Column="0" Background="White" CornerRadius="15,0,0,15" Margin="15,15,0,90">
            <StackPanel Margin="20,25">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <Ellipse Width="10" Height="10" Fill="#FF5F56" Margin="0,0,6,0"/>
                    <Ellipse Width="10" Height="10" Fill="#FFBD2E" Margin="0,0,6,0"/>
                    <Ellipse Width="10" Height="10" Fill="#27C93F" Margin="0,0,6,0"/>
                </StackPanel>

                <TextBlock Text="Библиотека" FontSize="17" Foreground="Black" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Home" HorizontalAlignment="Left" Background="DarkCyan" Foreground="Black" FontWeight="SemiBold" Padding="15,8" BorderBrush="Transparent" Width="150" Margin="0,0,0,8"/>
                <TextBlock Text="Моя волна" FontSize="15" Foreground="Black" Margin="15,8"/>
                <TextBlock Text="Мой плейлист" FontSize="15" Foreground="Black" Margin="15,8"/>
                <TextBlock Text="Чарты" FontSize="15" Foreground="Black" Margin="15,8"/>
                <TextBlock Text="Альбомы" FontSize="15" Foreground="Black" Margin="15,8"/>
                <TextBlock Text="Артисты" FontSize="15" Foreground="Black" Margin="15,8"/>

                <TextBlock Text="Мои" FontSize="20" Foreground="Black" FontWeight="Bold" Margin="0,25,0,10"/>
                <TextBlock Text="Недавние" FontSize="15" Foreground="Black" Margin="15,8"/>
                <TextBlock Text="Локальные" FontSize="15" Foreground="Black" Margin="15,8"/>
                <TextBlock Text="Фаворит" FontSize="15" Foreground="Black" Margin="15,8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="15,15,15,90">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock Text="Home" FontSize="40" FontWeight="Bold" Foreground="Black" Margin="0,0,0,15"/>

                <Border Background="DarkCyan" CornerRadius="12" Padding="20" Height="130">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Кружит" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="Monatik" Foreground="Black" FontSize="15" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,15,0,0">
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="25" Height="25" Fill="#BDC3C7" Margin="0,0,10,0"/>
                            <TextBlock Text="днями и ночами" VerticalAlignment="Center" FontSize="15" Foreground="Black"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="3:55" VerticalAlignment="Center" Foreground="#95A5A6" FontSize="12" Margin="15,0"/>
                        <Button Grid.Column="2" Content="♥" Background="Transparent" BorderBrush="Transparent" Foreground="#E74C3C"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="25" Height="25" Fill="#BDC3C7" Margin="0,0,10,0"/>
                            <TextBlock Text="Утро" VerticalAlignment="Center" FontSize="15" Foreground="Black"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="2:51" VerticalAlignment="Center" Foreground="#95A5A6" FontSize="12" Margin="15,0"/>
                        <Button Grid.Column="2" Content="♥" Background="Transparent" BorderBrush="Transparent" Foreground="#E74C3C"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="25" Height="25" Fill="#BDC3C7" Margin="0,0,10,0"/>
                            <TextBlock Text="Мандаринка" VerticalAlignment="Center" FontSize="15" Foreground="Black"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="3:51" VerticalAlignment="Center" Foreground="#95A5A6" FontSize="12" Margin="15,0"/>
                        <Button Grid.Column="2" Content="♥" Background="Transparent" BorderBrush="Transparent" Foreground="#E74C3C"/>
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="25" Height="25" Fill="#BDC3C7" Margin="0,0,10,0"/>
                            <TextBlock Text="Shake It Off" VerticalAlignment="Center" FontSize="15" Foreground="Black"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="3:39" VerticalAlignment="Center" Foreground="#95A5A6" FontSize="12" Margin="15,0"/>
                        <Button Grid.Column="2" Content="♥" Background="Transparent" BorderBrush="Transparent" Foreground="#E74C3C"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Популярное" FontSize="16" FontWeight="Bold" Foreground="Black" Margin="0,0,0,12"/>

                <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="35" Height="35" Fill="Red" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="My House" FontSize="15" FontWeight="Bold" Foreground="Black"/>
                            <TextBlock Text="Flo Rida" FontSize="13" Foreground="Black"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="35" Height="35" Fill="OliveDrab" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Blank Space" FontSize="15" FontWeight="Bold" Foreground="Black"/>
                            <TextBlock Text="Taylor Swift" FontSize="13" Foreground="Black"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Плейлист" FontSize="18" FontWeight="Bold" Foreground="Black" Margin="0,15,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="45" Height="45" Fill="Blue" Margin="0,0,15,0"/>
                    <Ellipse Width="45" Height="45" Fill="DarkBlue"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>